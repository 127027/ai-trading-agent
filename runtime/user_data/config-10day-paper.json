{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "ten-day-momentum-paper-v1",
  "strategy": "TenDayMomentumPaperV1",
  "timeframe": "15m",
  "max_open_trades": 1,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "available_capital": 100,
  "tradable_balance_ratio": 0.99,
  "amount_reserve_percent": 0.05,
  "dry_run": true,
  "dry_run_wallet": 100,
  "cancel_open_orders_on_exit": true,
  "trading_mode": "spot",
  "margin_mode": "",
  "position_adjustment_enable": false,
  "max_entry_position_adjustment": 0,
  "unfilledtimeout": {"entry": 5, "exit": 5, "exit_timeout_count": 2, "unit": "minutes"},
  "order_types": {
    "entry": "limit", "exit": "limit", "force_entry": "market",
    "force_exit": "market", "emergency_exit": "market", "stoploss": "limit",
    "stoploss_on_exchange": true, "stoploss_on_exchange_interval": 60,
    "stoploss_on_exchange_limit_ratio": 0.99
  },
  "order_time_in_force": {"entry": "GTC", "exit": "GTC"},
  "entry_pricing": {"price_side": "same", "use_order_book": true, "order_book_top": 1},
  "exit_pricing": {"price_side": "same", "use_order_book": true, "order_book_top": 1},
  "exchange": {
    "name": "binance",
    "ccxt_config": {
      "enableRateLimit": true,
      "options": {
        "defaultType": "spot",
        "fetchCurrencies": false,
        "fetchMargins": false,
        "fetchMarkets": {"types": ["spot"]}
      },
      "has": {"fetchCurrencies": false}
    },
    "ccxt_async_config": {
      "enableRateLimit": true,
      "options": {
        "defaultType": "spot",
        "fetchCurrencies": false,
        "fetchMargins": false,
        "fetchMarkets": {"types": ["spot"]}
      },
      "has": {"fetchCurrencies": false}
    },
    "pair_whitelist": [
      "BTC/USDT", "ETH/USDT", "SOL/USDT", "BNB/USDT", "XRP/USDT", "ADA/USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [{"method": "StaticPairList"}],
  "initial_state": "running",
  "force_entry_enable": false,
  "db_url": "sqlite:///user_data/tradesv3.ten-day-paper-v1.sqlite",
  "dataformat_ohlcv": "feather",
  "dataformat_trades": "feather"
}
